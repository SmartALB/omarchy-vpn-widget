#!/usr/bin/env bash
# Remove only plugin system artefacts, never VPN files, list or running units.
set -uo pipefail
SYSTEM=false
for arg in "$@"; do
  case "$arg" in --system) SYSTEM=true ;; *) echo "Usage: $0 [--system]" >&2; exit 64 ;; esac
done
CONF="${OMARCHY_VPN_CONNECTIONS:-$HOME/.config/omarchy/vpn-connections.json}"
PRIV="${OMARCHY_VPN_PRIVILEGED:-/usr/local/bin/omarchy-vpn-switch}"
IMPORT="${OMARCHY_VPN_IMPORT:-/usr/local/bin/omarchy-vpn-import}"
POLICY="${OMARCHY_VPN_POLICY:-/usr/share/polkit-1/actions/org.omarchy.smartalbvpn.import.policy}"
SWITCH_POLICY="${OMARCHY_VPN_SWITCH_POLICY:-/usr/share/polkit-1/actions/org.omarchy.smartalbvpn.switch.policy}"
SUDOERS="${OMARCHY_VPN_SUDOERS:-/etc/sudoers.d/smartalb-vpn}"
LEGACY_PRIV="${OMARCHY_VPN_LEGACY_PRIVILEGED:-/usr/local/bin/omarchy-vpn-privileged}"
if [ "$SYSTEM" = false ]; then
  echo "Nothing to do. The connection list is kept: $CONF"
  echo "Use ./uninstall --system to remove the two helpers and two Polkit policies."
  echo "An exact legacy sudoers grant for this user is also revoked, if present."
  echo "VPN configurations and running connections keep running unchanged."
  exit 0
fi
[ "$(id -u)" != 0 ] || { echo 'Run as your normal user, not root.' >&2; exit 1; }
sudo env VPN_UID="$(id -u)" VPN_LOGIN="$(id -un)" VPN_PRIV="$PRIV" VPN_IMPORT="$IMPORT" \
  VPN_POLICY="$POLICY" VPN_SWITCH_POLICY="$SWITCH_POLICY" VPN_SUDOERS="$SUDOERS" VPN_LEGACY_PRIV="$LEGACY_PRIV" bash -p -c '
set -euo pipefail
for v in VPN_PRIV VPN_IMPORT VPN_POLICY VPN_SWITCH_POLICY VPN_SUDOERS VPN_LEGACY_PRIV; do
  case "${!v}" in /*) ;; *) echo "Non-absolute path refused: $v" >&2; exit 1 ;; esac
done
# Check all artefacts before deleting any, including dangling symlinks.
for path in "$VPN_PRIV" "$VPN_IMPORT" "$VPN_POLICY" "$VPN_SWITCH_POLICY" "$VPN_SUDOERS"; do
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -f "$path" ] && [ ! -L "$path" ] || { echo "Not a plain file, kept: $path" >&2; exit 1; }
  fi
done
if [ -f "$VPN_SUDOERS" ]; then
  [ "$(stat -c %s "$VPN_SUDOERS")" -le 1024 ] || { echo "Legacy rule requires manual review" >&2; exit 1; }
  oldrule="$(cat "$VPN_SUDOERS")"
  numeric="#${VPN_UID} ALL=(root) NOPASSWD: ${VPN_LEGACY_PRIV}"
  named="${VPN_LOGIN} ALL=(root) NOPASSWD: ${VPN_LEGACY_PRIV}"
  [ "$oldrule" = "$numeric" ] || [ "$oldrule" = "$named" ] || { echo "Custom legacy sudoers file kept; manual review required" >&2; exit 1; }
  rm -f -- "$VPN_SUDOERS"
fi
# Policies first; the legacy helper is left inert rather than deleting an
# independently modified executable whose provenance we cannot establish.
rm -f -- "$VPN_SWITCH_POLICY" "$VPN_POLICY"
rm -f -- "$VPN_PRIV" "$VPN_IMPORT"
'
rc=$?
[ "$rc" -eq 0 ] && echo 'Done. Connection list, VPN configurations and running tunnels are untouched.'
exit "$rc"
