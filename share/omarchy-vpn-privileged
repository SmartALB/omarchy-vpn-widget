#!/bin/bash -p
# Installed as /usr/local/bin/omarchy-vpn-switch, root:root 0755.
# Every call goes through pkexec/auth_admin; there is no sudoers grant.
# A switch validates the complete unit set before making any changes, then
# stops group peers and starts the target inside ONE authorized operation.
set -uo pipefail
export PATH=/usr/bin:/bin LC_ALL=C
ME="${0##*/}"
SYSTEMCTL=/usr/bin/systemctl
TIMEOUT=/usr/bin/timeout
LOCK=/run/omarchy-vpn-switch.lock
MAX_SECONDS=90

fail() { printf '%s: %s\n' "$ME" "$2" >&2; exit "$1"; }
[ "$#" -ge 2 ] && [ "$#" -le 201 ] || fail 64 'expected <start|stop|switch> <unit> [group peers...]'
action="$1"; shift
case "$action" in start|stop) [ "$#" -eq 1 ] || fail 64 'start/stop accepts one unit' ;; switch) ;; *) fail 65 "disallowed action: ${action:0:80}" ;; esac

units=()
declare -A seen=()
for unit in "$@"; do
  unit="${unit%.service}"
  [[ "$unit" =~ ^(openvpn-client|wg-quick)@[A-Za-z0-9_.-]+$ ]] && [ "${#unit}" -le 240 ] || fail 66 "disallowed unit name: ${unit:0:80}"
  [ -z "${seen[$unit]:-}" ] || fail 66 'duplicate unit in request'
  seen[$unit]=1
  units+=("$unit")
done

# /run is root-owned; never use a user-controlled directory for this lock.
[ ! -L "$LOCK" ] || fail 1 'lock path is a symlink'
umask 077
exec 9>"$LOCK" || fail 1 'cannot open operation lock'
/usr/bin/flock -n 9 || fail 1 'another VPN operation is in progress'
SECONDS=0
run() {
  local remaining=$((MAX_SECONDS - SECONDS)) rc
  [ "$remaining" -gt 0 ] || fail 124 'VPN operation timed out; systemd jobs may still be running'
  "$TIMEOUT" -k 2 "$remaining" "$SYSTEMCTL" "$@"
  rc=$?
  [ "$rc" -ne 124 ] && [ "$rc" -ne 137 ] || fail 124 'VPN operation timed out; systemd jobs may still be running'
  [ "$rc" -ne 126 ] && [ "$rc" -ne 127 ] || fail 1 'could not execute systemctl'
  return "$rc"
}
state() {
  local result rc
  result="$(run is-active -- "$1.service")"; rc=$?
  [ "$rc" -ne 124 ] || fail 124 'VPN status query timed out'
  case "$result" in active|inactive|failed|activating|deactivating|reloading) printf '%s' "$result" ;;
    *) fail 1 'cannot determine VPN service state' ;;
  esac
}
target="${units[0]}"
if [ "$action" != switch ]; then
  run "$action" -- "$target.service"
  exit $?
fi
current="$(state "$target")" || exit $?
case "$current" in
  active|activating|reloading|deactivating) run stop -- "$target.service"; exit $? ;;
esac
for peer in "${units[@]:1}"; do
  current="$(state "$peer")" || exit $?
  case "$current" in inactive|failed) continue ;; esac
  run stop -- "$peer.service" || exit $?
done
run start -- "$target.service"
