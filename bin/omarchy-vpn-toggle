#!/usr/bin/env bash
# One pkexec authentication for the complete group switch. The root helper
# rechecks service state AFTER authorization and validates every unit first.
set -uo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
. "$SELF_DIR/_common.sh"
ME="${0##*/}"
need_jq
[ "$#" -eq 1 ] && [ -n "$1" ] || { echo "Usage: $ME <connection-id>" >&2; exit 1; }
conns="$(read_connections)" || { echo "$ME: connection list not readable: $CONNECTIONS_FILE" >&2; exit 5; }
entry="$(printf '%s' "$conns" | jq -c --arg id "$1" 'map(select(.id == $id)) | .[0] // empty')"
[ -n "$entry" ] || { echo "$ME: unknown connection: $1" >&2; exit 2; }
unit="$(printf '%s' "$entry" | jq -r '.unit // ""')"
group="$(printf '%s' "$entry" | jq -r '.group // ""')"
[ -n "$unit" ] || { echo "$ME: connection has no unit -- check the configuration" >&2; exit 5; }
units=("$unit")
if [ -n "$group" ]; then
  while IFS= read -r other; do
    [ "$other" = "$unit" ] || units+=("$other")
  done < <(printf '%s' "$conns" | jq -r --arg g "$group" '.[] | select((.group // "") == $g) | .unit // ""')
fi
[ "${#units[@]}" -le 200 ] || { echo "$ME: too many group members" >&2; exit 5; }
declare -A seen=()
normalized=()
for u in "${units[@]}"; do
  u="${u%.service}"
  [[ "$u" =~ ^(openvpn-client|wg-quick)@[A-Za-z0-9_.-]+$ ]] && [ "${#u}" -le 240 ] || {
    echo "$ME: disallowed unit name in connection list: ${u:0:80}" >&2; exit 5;
  }
  [ -z "${seen[$u]:-}" ] || continue
  seen[$u]=1; normalized+=("$u.service")
done
[ -x "$VPN_PRIVILEGED" ] || {
  echo "$ME: Polkit switching helper missing. Run the reviewed install --system migration first." >&2; exit 4;
}
# Never fall back to the legacy NOPASSWD helper. Auth time is not charged to
# systemctl's budget; the helper has its own bounded execution after approval.
command -v pkexec >/dev/null 2>&1 || { echo "$ME: pkexec is missing" >&2; exit 4; }
pkexec "$VPN_PRIVILEGED" switch "${normalized[@]}"
rc=$?
case "$rc" in
  0) exit 0 ;;
  126) echo "$ME: authentication cancelled -- no VPN change requested" >&2; exit 4 ;;
  127) echo "$ME: authentication denied or helper could not be started" >&2; exit 4 ;;
  124|137) echo "$ME: VPN operation timed out; systemd jobs may still be running" >&2; exit 6 ;;
  *) exit 4 ;;
esac
