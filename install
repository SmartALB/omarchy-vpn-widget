#!/usr/bin/env bash
# Prepares the smartalb.vpn plugin: make bin/ executable, create a sample
# configuration and check the requirements.
# Idempotent, may be run repeatedly.
set -uo pipefail

SILENT=false
SYSTEM=false
for arg in "$@"; do
  case "$arg" in
    --silent) SILENT=true ;;
    --system) SYSTEM=true ;;
    *) printf 'Usage: %s [--silent] [--system]\n' "$0" >&2; exit 64 ;;
  esac
done
say() { [ "$SILENT" = true ] || printf '%s\n' "$*"; }

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Named one by one, not "share/*": omarchy-vpn-import.policy is XML that
# polkit reads, and an executable bit on it is wrong. A blanket glob would
# also catch whatever data file lands in share/ later.
chmod +x "$DIR"/bin/* \
         "$DIR/share/omarchy-vpn-privileged" "$DIR/share/omarchy-vpn-import" \
         "$DIR/install" "$DIR/uninstall" "$DIR/test/run-tests.sh" 2>/dev/null

CONF="${OMARCHY_VPN_CONNECTIONS:-$HOME/.config/omarchy/vpn-connections.json}"
PRIV="${OMARCHY_VPN_PRIVILEGED:-/usr/local/bin/omarchy-vpn-privileged}"
IMPORT="${OMARCHY_VPN_IMPORT:-/usr/local/bin/omarchy-vpn-import}"
POLICY="${OMARCHY_VPN_POLICY:-/usr/share/polkit-1/actions/org.omarchy.smartalbvpn.import.policy}"
SUDOERS="${OMARCHY_VPN_SUDOERS:-/etc/sudoers.d/smartalb-vpn}"

HAVE_JQ=false
command -v jq >/dev/null 2>&1 && HAVE_JQ=true

if [ -f "$CONF" ]; then
  # The same criteria as read_connections() in bin/_common.sh: valid JSON,
  # an array, every element an object. install used to report "present,
  # left unchanged" here without looking -- even for a broken file. The
  # user then saw an empty popup later and went looking in the wrong place.
  # On an error the file is NOT overwritten, it is the user's
  # configuration -- only a clear warning with the path and what was
  # expected.
  if [ "$HAVE_JQ" = true ] && \
     jq -e 'type == "array" and all(.[]; type == "object")' "$CONF" >/dev/null 2>&1; then
    say "Configuration present, left unchanged: $CONF"
  elif [ "$HAVE_JQ" = true ]; then
    say "WARNING: configuration present, but invalid: $CONF"
    say "         Expected is a JSON array of objects, e.g.:"
    say '         [{ "id": "...", "label": "...", "unit": "...", "group": "..." }]'
    say "         The file was NOT changed. Without a correction the panel"
    say "         stays empty."
  else
    say "Configuration present, left unchanged: $CONF"
    say "WARNING: jq missing -- the content could not be checked."
  fi
else
  mkdir -p "$(dirname "$CONF")"
  cat >"$CONF" <<'JSON'
[]
JSON
  say "Configuration created: $CONF"
  say "         Still empty -- you add connections through the widget"
  say "         (open the panel, 'Add connection')."
fi

[ "$HAVE_JQ" = true ] || say "WARNING: jq missing -- without jq the panel stays empty."
# 'timeout' has bounded every systemctl call in list and toggle since the
# timeout exit code (6) was introduced -- by now a hard dependency, not
# merely a convenience (review M10).
command -v timeout >/dev/null 2>&1 || say "WARNING: timeout missing -- omarchy-vpn-list and omarchy-vpn-toggle need it."

# Whether the helper program is installed can be answered without
# executing anything -- unlike the question whether passwordless sudo is
# set up. For that there is still no harmless probe: a call with a real
# unit could actually bring the connection up, and '--dry-run' is,
# according to man(1) systemctl, not provided for the 'start' verb.
if [ -x "$PRIV" ]; then
  say "Helper program present: $PRIV"

  # That "present and executable" also means "the right file, with the
  # right permissions, in a directory nobody else can write to" is what
  # this step is for -- see the README, section Requirements.
  if ! cmp -s "$DIR/share/omarchy-vpn-privileged" "$PRIV"; then
    say "WARNING: $PRIV differs from the shipped share/omarchy-vpn-privileged"
    say "         (outdated or modified). Repeat the install command:"
    say ""
    say "           sudo install -m 755 -o root -g root \\"
    say "             \"$DIR/share/omarchy-vpn-privileged\" $PRIV"
    say ""
  fi

  OWNER_MODE="$(stat -c '%U %a' "$PRIV" 2>/dev/null)"
  if [ "$OWNER_MODE" != "root 755" ]; then
    say "WARNING: $PRIV is not owned by root with mode 755 (found:"
    say "         ${OWNER_MODE:-unknown}). A NOPASSWD rule on a file that is"
    say "         not owned by root, or is writable too widely, is a root"
    say "         shell. Correct it with:"
    say "           sudo chown root:root $PRIV && sudo chmod 755 $PRIV"
  fi

  PRIVDIR="$(dirname "$PRIV")"
  if [ -w "$PRIVDIR" ]; then
    say "WARNING: $PRIVDIR is writable for this user."
    say "         Even if $PRIV is owned by root, it can be replaced inside a"
    say "         writable directory -- likewise a root shell. Check and"
    say "         correct the directory permissions."
  fi
else
  say "WARNING: helper program missing: $PRIV"
  say "         Without it nothing can be switched. Once, as root:"
  say ""
  say "           sudo install -m 755 -o root -g root \\"
  say "             \"$DIR/share/omarchy-vpn-privileged\" $PRIV"
  say "           printf '%s ALL=(root) NOPASSWD: %s\\n' \"\$USER\" $PRIV \\"
  say "             | sudo tee /tmp/smartalb-vpn.new >/dev/null"
  say "           sudo visudo -c -f /tmp/smartalb-vpn.new"
  say "           sudo install -m 440 -o root -g root /tmp/smartalb-vpn.new /etc/sudoers.d/smartalb-vpn"
  say "           sudo rm -f /tmp/smartalb-vpn.new"
  say "           sudo visudo -c"
  say ""
  say "         The order is deliberate: check the new line in a temporary"
  say "         file first (visudo -c -f), and only then put it into"
  say "         /etc/sudoers.d/. A typo written straight into the target"
  say "         file would otherwise cripple every sudo on the machine"
  say "         between the write and the correction."
  say ""
  say "         The helper program must be owned by root and must NOT be"
  say "         writable for the user -- a NOPASSWD rule on a writable file"
  say "         is a root shell. Hence into /usr/local/bin and not out of"
  say "         the plugin directory."
fi

if [ -x "$IMPORT" ]; then
  say "Import helper program present: $IMPORT"
  [ -r "$POLICY" ] || say "WARNING: polkit action missing: $POLICY -- the password dialog then shows only the program path."
else
  say "WARNING: import helper program missing: $IMPORT"
  say "         Without it no connections can be created through the"
  say "         widget. Once, as root:"
  say ""
  say "           sudo install -m 755 -o root -g root \\"
  say "             \"$DIR/share/omarchy-vpn-import\" $IMPORT"
  say "           sudo install -m 644 -o root -g root \\"
  say "             \"$DIR/share/omarchy-vpn-import.policy\" $POLICY"
  say ""
  say "         Unlike the switching program this one does NOT run without a"
  say "         password: it writes into /etc, and a configuration placed"
  say "         there is later executed with system privileges."
fi

command -v pkexec >/dev/null 2>&1 || \
  say "WARNING: pkexec missing (package polkit) -- without it there is no password dialog."

say "Note: whether passwordless sudo really works shows on the first"
say "      switch -- omarchy-vpn-toggle then says so clearly."
say "      Everything privileged at once: ./install --system"

# ------------------------------------------------------------ --system
#
# The four privileged steps, which used to be copied out of the README by
# hand. Two of the three mishaps when installing on a second machine came
# from that copying: one of four commands never ran, and the sudoers line
# existed in two spellings.
#
# Deliberately NOT part of the default run: without --system this script
# executes nothing privileged and touches nothing outside $HOME, so it can
# be used as a check at any time. Handing over a password stays something
# one asks for.
[ "$SYSTEM" = true ] || exit 0

# Running under sudo, $USER would be root and the rule would name root --
# it would grant nothing to the person who is supposed to switch. FAKE_EUID
# exists for the test suite, which cannot become root.
if [ "${FAKE_EUID:-$(id -u)}" = "0" ]; then
  say "install --system must be run as your own user, not as root --"
  say "otherwise the sudoers line names root instead of you."
  exit 1
fi

# Everything privileged happens in ONE root process, and it is handed the
# reviewed bytes rather than a path.
#
# The marketplace security review found the previous shape wanting, rightly.
# It validated a sudoers file in /tmp with one sudo call and installed it
# with the next -- and between the two the file belonged to the user. A
# process under the same uid could swap it and have an arbitrary NOPASSWD
# rule published. The scratch file guarded against a typo; it never guarded
# against an attacker, it created the opening.
#
# The same held for the programs: root reopened them from the plugin
# directory, which the user can write. What a reviewer had read and what
# root published were not necessarily the same bytes.
#
# So: the payload travels through the pipe, root unpacks it into a directory
# of its own that nobody else can reach, and validates and publishes from
# there. Nothing under $DIR is named to sudo at all.
uid="$(id -u 2>/dev/null)"
case "${uid:-}" in
  ''|*[!0-9]*) say "FAILED: could not determine a numeric user id"; exit 1 ;;
esac

for f in omarchy-vpn-privileged omarchy-vpn-import omarchy-vpn-import.policy; do
  [ -r "$DIR/share/$f" ] || { say "FAILED: missing: share/$f"; exit 1; }
done

# The rule binds '#<uid>', not a login name. A name is text that sudoers
# interprets -- an account called 'ALL' would change what the rule means.
# The payload is read ONCE, into a copy, and bound to a digest taken from
# exactly those bytes. Archiving straight out of the checkout meant tar
# opened each file a second time, after the decision to install had been
# made -- a same-uid swap in that moment would have published bytes nobody
# looked at (second review round).
#
# This narrows it to a single read and lets root refuse anything that does
# not match what was hashed here. It does NOT make an adversary already
# running as this user harmless: the copy and its digest are made by that
# same user. Only a binding to something outside the checkout -- a signed
# release -- closes that, which is a question for the marketplace rather
# than for this script. The digests are printed so they can be compared
# against a published release.
payload="$(mktemp -d)" || { say "FAILED: no staging directory"; exit 1; }
trap 'rm -rf "$payload"' EXIT
for f in omarchy-vpn-privileged omarchy-vpn-import omarchy-vpn-import.policy; do
  cat -- "$DIR/share/$f" >"$payload/$f" || { say "FAILED: could not read share/$f"; exit 1; }
done
digests="$(cd "$payload" && sha256sum omarchy-vpn-privileged omarchy-vpn-import omarchy-vpn-import.policy)" \
  || { say "FAILED: could not fingerprint the payload"; exit 1; }
say "Payload fingerprints:"
printf '  %s\n' "$digests"

tar -C "$payload" -cf - \
      omarchy-vpn-privileged omarchy-vpn-import omarchy-vpn-import.policy 2>/dev/null \
  | sudo env VPN_UID="$uid" VPN_PRIV="$PRIV" VPN_IMPORT="$IMPORT" \
         VPN_POLICY="$POLICY" VPN_SUDOERS="$SUDOERS" VPN_DIGESTS="$digests" bash -c '
set -uo pipefail
umask 077

case "${VPN_UID:-}" in ''"''"''|*[!0-9]*) echo "root: uid is not numeric" >&2; exit 1 ;; esac
for v in VPN_PRIV VPN_IMPORT VPN_POLICY VPN_SUDOERS; do
  case "${!v}" in /*) ;; *) echo "root: $v is not an absolute path" >&2; exit 1 ;; esac
done

# mktemp -d already creates with mode 0700, owned by root -- no chmod, and
# nothing but root can reach what is staged here.
stage="$(mktemp -d)" || { echo "root: no staging directory" >&2; exit 1; }
trap '"'"'rm -rf "$stage"'"'"' EXIT
tar -C "$stage" -xf - || { echo "root: could not unpack the payload" >&2; exit 1; }

for f in omarchy-vpn-privileged omarchy-vpn-import omarchy-vpn-import.policy; do
  [ -f "$stage/$f" ] && [ ! -L "$stage/$f" ] || { echo "root: payload incomplete: $f" >&2; exit 1; }
done

# The bytes that arrived have to be the bytes that were fingerprinted. This
# is checked INSIDE the privileged process, before anything is published.
printf "%s\n" "$VPN_DIGESTS" >"$stage/digests"
( cd "$stage" && sha256sum -c --status digests ) || {
  echo "root: the payload does not match its fingerprints -- nothing was changed" >&2
  exit 1
}
rm -f "$stage/digests"

printf "#%s ALL=(root) NOPASSWD: %s\n" "$VPN_UID" "$VPN_PRIV" >"$stage/sudoers"
if ! visudo -c -f "$stage/sudoers" >/dev/null; then
  echo "root: the generated sudoers rule was rejected -- nothing was changed" >&2
  exit 1
fi

# Publication, one destination at a time. Before overwriting, the old
# content is kept so an interrupted run can be undone; a destination that
# is not a plain file is refused rather than replaced.
undo=()
restore() {
  local i
  for ((i=${#undo[@]}-1; i>=0; i--)); do
    set -- ${undo[i]}
    case "$1" in
      keep) install -m "$4" -o root -g root "$2" "$3" 2>/dev/null || true ;;
      drop) rm -f "$3" 2>/dev/null || true ;;
    esac
  done
}
publish() {
  local src="$1" dst="$2" mode="$3" n oldmode
  n="${dst##*/}"
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    # A destination that is not a plain file is refused, not replaced: a
    # symlink there would send the write somewhere else entirely.
    [ -f "$dst" ] && [ ! -L "$dst" ] || { echo "root: $dst is not a plain file" >&2; return 1; }
    if cmp -s "$src" "$dst"; then echo "already current: $dst"; return 0; fi
    oldmode="$(stat -c %a "$dst" 2>/dev/null)" || return 1
    cat "$dst" >"$stage/backup.$n" || return 1
    undo+=("keep $stage/backup.$n $dst ${oldmode:-$mode}")
  else
    undo+=("drop - $dst -")
  fi
  echo "installing $dst"
  # Written beside the destination and moved onto it: a reader sees either
  # the old file or the new one, never half of either.
  install -m "$mode" -o root -g root "$src" "$dst.new.$$" || return 1
  mv -f "$dst.new.$$" "$dst" || { rm -f "$dst.new.$$"; return 1; }
}

# Grant last: the program has to be in place before the rule that points at
# it. The other way round leaves a rule pointing at nothing -- and sudo does
# not treat a rule whose program it cannot resolve as matching, so a missing
# program presents itself as a missing permission.
publish "$stage/omarchy-vpn-privileged"   "$VPN_PRIV"   755 || { restore; exit 1; }
publish "$stage/omarchy-vpn-import"       "$VPN_IMPORT" 755 || { restore; exit 1; }
publish "$stage/omarchy-vpn-import.policy" "$VPN_POLICY" 644 || { restore; exit 1; }
publish "$stage/sudoers"                  "$VPN_SUDOERS" 440 || { restore; exit 1; }
' || { say "FAILED: the privileged step did not complete -- nothing was left half done."; exit 1; }

say "System part done. If the widget is running: omarchy-restart-shell"
